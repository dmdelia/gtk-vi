extends RefCounted
## Shared real bitmap PBR materials and reusable detailed geometry.
## Texture maps are generated by tools/generate_textures.py before the Godot import.

static var _materials: Dictionary = {}

static func material(kind: String, tint: Color = Color.WHITE, metal = -1.0) -> StandardMaterial3D:
	var key = "%s|%s|%s" % [kind, tint.to_html(), metal]
	if _materials.has(key):
		return _materials[key]
	var m = StandardMaterial3D.new()
	m.albedo_color = tint
	m.uv1_triplanar = true
	m.uv1_scale = Vector3(0.55, 0.55, 0.55)
	m.roughness = 0.74
	m.metallic = 0.0
	m.texture_filter = BaseMaterial3D.TEXTURE_FILTER_LINEAR_WITH_MIPMAPS_ANISOTROPIC
	var albedo_path = "res://assets/textures/%s_albedo.png" % kind
	var normal_path = "res://assets/textures/%s_normal.png" % kind
	var rough_path = "res://assets/textures/%s_roughness.png" % kind
	if ResourceLoader.exists(albedo_path):
		m.albedo_texture = load(albedo_path)
	if ResourceLoader.exists(normal_path):
		m.normal_enabled = true
		m.normal_texture = load(normal_path)
		m.normal_scale = 0.48
	if ResourceLoader.exists(rough_path):
		m.roughness_texture = load(rough_path)
		m.roughness_texture_channel = BaseMaterial3D.TEXTURE_CHANNEL_RED
		m.roughness = 1.0
	if kind in ["steel", "sheetmetal", "roof", "machine"]:
		m.metallic = 0.38
	if metal >= 0.0:
		m.metallic = metal
	_material_style(m, kind)
	_materials[key] = m
	return m

static func _material_style(mat: StandardMaterial3D, kind: String) -> void:
	match kind:
		"asphalt", "concrete", "cardboard", "brick", "wood", "fabric":
			mat.metallic = 0
		"rubber":
			mat.roughness = 0.92
		"roof":
			mat.uv1_scale = Vector3(0.33, 0.33, 0.33)
		"sheetmetal":
			mat.uv1_scale = Vector3(0.4, 0.4, 0.4)

static func plain(color: Color, metallic = 0.0, roughness = 0.55, emissive = false) -> StandardMaterial3D:
	var m = StandardMaterial3D.new()
	m.albedo_color = color
	m.metallic = metallic
	m.roughness = roughness
	if emissive:
		m.emission_enabled = true
		m.emission = color
		m.emission_energy_multiplier = 1.6
	return m

static func add(parent: Node3D, mesh: Mesh, location: Vector3, mat: Material, rot: Vector3 = Vector3.ZERO) -> MeshInstance3D:
	var node = MeshInstance3D.new()
	node.mesh = mesh
	node.material_override = mat
	node.position = location
	node.rotation = rot
	parent.add_child(node)
	return node

static func cuboid(parent: Node3D, location: Vector3, dim: Vector3, mat: Material, rot: Vector3 = Vector3.ZERO) -> MeshInstance3D:
	var m = BoxMesh.new()
	m.size = dim
	return add(parent, m, location, mat, rot)

static func cylinder(parent: Node3D, location: Vector3, radius: float, height: float, mat: Material, radial_segments = 16, rot: Vector3 = Vector3.ZERO) -> MeshInstance3D:
	var m = CylinderMesh.new()
	m.top_radius = radius
	m.bottom_radius = radius
	m.height = height
	m.radial_segments = radial_segments
	m.rings = 1
	return add(parent, m, location, mat, rot)

static func sphere(parent: Node3D, location: Vector3, dim: Vector3, mat: Material, segments = 16) -> MeshInstance3D:
	var m = SphereMesh.new()
	m.radius = 0.5
	m.height = 1.0
	m.radial_segments = segments
	m.rings = 8
	var inst = add(parent, m, location, mat)
	inst.scale = dim
	return inst

static func capsule(parent: Node3D, location: Vector3, radius: float, height: float, mat: Material, segments = 12) -> MeshInstance3D:
	var m = CapsuleMesh.new()
	m.radius = radius
	m.height = height
	m.radial_segments = segments
	m.rings = 8
	return add(parent, m, location, mat)

static func pipe_between(parent: Node3D, start: Vector3, end: Vector3, radius: float, mat: Material, segments = 12) -> MeshInstance3D:
	var v = end - start
	var mesh = CylinderMesh.new()
	mesh.top_radius = radius
	mesh.bottom_radius = radius
	mesh.height = v.length()
	mesh.radial_segments = segments
	var node = add(parent, mesh, (start + end) * 0.5, mat)
	if v.length() > 0.001:
		node.quaternion = Quaternion(Vector3.UP, v.normalized())
	return node

static func wheel(parent: Node3D, p: Vector3, radius: float, width: float, metallic_mat: Material) -> Node3D:
	var pivot = Node3D.new()
	pivot.position = p
	parent.add_child(pivot)
	cylinder(pivot, Vector3.ZERO, radius, width, material("rubber", Color("#333638")), 24, Vector3(0, 0, PI * .5))
	for side in [-1, 1]:
		cylinder(pivot, Vector3(side * (width * .51), 0, 0), radius * .58, .027, metallic_mat, 20, Vector3(0, 0, PI * .5))
		for i in range(5):
			var theta = TAU * float(i) / 5.0
			cylinder(pivot, Vector3(side * (width * .55), cos(theta) * radius * .35, sin(theta) * radius * .35), .038, .035, plain(Color("#333b42"), .45), 8, Vector3(0, 0, PI * .5))
	return pivot

static func wedge(parent: Node3D, p: Vector3, width: float, length: float, front_height: float, rear_height: float, mat: Material) -> MeshInstance3D:
	# Slanted 6-face hull (not a cube): two trapezoid sides with a sloping roof.
	var hw = width * 0.5
	var hl = length * 0.5
	var v = [
		Vector3(-hw, 0, -hl), Vector3(hw, 0, -hl),
		Vector3(-hw, 0, hl), Vector3(hw, 0, hl),
		Vector3(-hw, front_height, -hl), Vector3(hw, front_height, -hl),
		Vector3(-hw, rear_height, hl), Vector3(hw, rear_height, hl),
	]
	var triangles = [0,2,1,1,2,3, 0,1,4,1,5,4, 2,6,3,3,6,7,
		0,4,2,2,4,6, 1,3,5,3,7,5, 4,5,6,5,7,6]
	var st = SurfaceTool.new()
	st.begin(Mesh.PRIMITIVE_TRIANGLES)
	for i in triangles:
		st.set_uv(Vector2(v[i].x*.5+1.0,v[i].z*.5+1.0))
		st.add_vertex(v[i])
	st.generate_normals()
	return add(parent, st.commit(), p, mat)
